# Repository location. Override DOTFILES_DIR when the repository is cloned elsewhere.
dotfiles_dir="${DOTFILES_DIR:-$HOME/.dotfiles}"

# Load OS-specific configurations
if [[ "$OSTYPE" == "darwin"* ]]; then
  [ -f "$dotfiles_dir/config/shell/macos.zshrc" ] && source "$dotfiles_dir/config/shell/macos.zshrc"
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
  [ -f "$dotfiles_dir/config/shell/linux.zshrc" ] && source "$dotfiles_dir/config/shell/linux.zshrc"
fi
# End of OS-specific configurations

# Aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
# Aliases end

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
# nvm end

# Oh My Posh
eval "$(oh-my-posh init zsh --config "$dotfiles_dir/config/prompt/theme.omp.json")"
# End of Oh My Posh
